{
  "paths": {
    "/api/admin/stats": {
      "get": {"summary": "Get the dashboard statistics", "description": "Users and reviews (rows with text) totals, most watched and highest rated films, popular genres and a daily activity series.", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "days", "in": "query", "required": false, "description": "Days of activity to return (default 30).", "schema": {"type": "integer", "minimum": 1, "maximum": 90}}], "responses": {"200": {"description": "Dashboard statistics."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins only."}, "422": {"description": "Validation failed."}}}
    },
    "/api/admin/users": {
      "get": {"summary": "List users", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "q", "in": "query", "required": false, "description": "Matches name, username or email.", "schema": {"type": "string"}}, {"name": "role", "in": "query", "required": false, "schema": {"type": "string", "enum": ["user", "admin"]}}, {"name": "status", "in": "query", "required": false, "schema": {"type": "string", "enum": ["active", "inactive"]}}, {"name": "page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1}}, {"name": "per_page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 50}}], "responses": {"200": {"description": "A page of users."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins only."}, "422": {"description": "Validation failed."}}}
    },
    "/api/admin/users/{user}": {
      "patch": {"summary": "Change a user's role or active state", "description": "Deactivating a user signs them out everywhere. Admins cannot demote or deactivate themselves.", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "user", "in": "path", "required": true, "schema": {"type": "integer"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"role": {"type": "string", "enum": ["user", "admin"]}, "is_active": {"type": "boolean"}}}}}}, "responses": {"200": {"description": "User updated."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins only, or the admin targeted their own account."}, "404": {"description": "User not found."}, "422": {"description": "Validation failed."}}},
      "delete": {"summary": "Delete a user", "description": "Admins cannot delete themselves.", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "user", "in": "path", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "User deleted."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins only, or the admin targeted their own account."}, "404": {"description": "User not found."}}}
    },
    "/api/admin/reviews": {
      "get": {"summary": "List reviews to moderate", "description": "Only reviews with text; star ratings have nothing to moderate.", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "status", "in": "query", "required": false, "description": "Defaults to pending.", "schema": {"type": "string", "enum": ["pending", "approved"]}}, {"name": "page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1}}, {"name": "per_page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 50}}], "responses": {"200": {"description": "A page of reviews."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins only."}, "422": {"description": "Validation failed."}}}
    },
    "/api/admin/reviews/{review}": {
      "patch": {"summary": "Approve or reject a review", "description": "Rejecting removes the text and keeps the member's star rating.", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "review", "in": "path", "required": true, "schema": {"type": "integer"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string", "enum": ["approved", "rejected"]}}}}}}, "responses": {"200": {"description": "Review moderated."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins only."}, "404": {"description": "Review not found."}, "422": {"description": "Validation failed."}}},
      "delete": {"summary": "Delete a review", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "review", "in": "path", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "Review deleted."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins only."}, "404": {"description": "Review not found."}}}
    },
    "/api/admin/movies": {
      "get": {"summary": "List the local movie catalogue", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "q", "in": "query", "required": false, "description": "Matches the title.", "schema": {"type": "string"}}, {"name": "page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1}}, {"name": "per_page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 50}}], "responses": {"200": {"description": "A page of local movies."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins only."}, "422": {"description": "Validation failed."}}}
    },
    "/api/admin/movies/{tmdbId}": {
      "patch": {"summary": "Hide, feature or edit a local movie", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "tmdbId", "in": "path", "required": true, "schema": {"type": "integer"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"title": {"type": "string"}, "overview": {"type": "string", "nullable": true}, "is_hidden": {"type": "boolean"}, "is_featured": {"type": "boolean"}}}}}}, "responses": {"200": {"description": "Movie updated."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins only."}, "404": {"description": "The film is not in the local catalogue."}, "422": {"description": "Validation failed."}}}
    }
  }
}
