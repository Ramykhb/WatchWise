{
  "paths": {
    "/api/admin/stats": {
      "get": {"summary": "Get the dashboard statistics (admins and moderators)", "description": "Users and reviews (rows with text) totals, active_today / active_yesterday (members seen that day), flagged_reviews (reviews with unresolved reports), a range block (new users and reviews in the window and the equally long one before it), most watched and highest rated films, popular genres and a daily activity series.", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "days", "in": "query", "required": false, "description": "Days of activity to return (default 30).", "schema": {"type": "integer", "minimum": 1, "maximum": 90}}, {"name": "range", "in": "query", "required": false, "description": "Window shortcut that wins over days: 7, 30, 90 or year (1 January to today).", "schema": {"type": "string", "enum": ["7", "30", "90", "year"]}}], "responses": {"200": {"description": "Dashboard statistics."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins and moderators only."}, "422": {"description": "Validation failed."}}}
    },
    "/api/admin/users": {
      "get": {"summary": "List users (admins and moderators, read-only)", "description": "Each user has status, reviews_count and last_active_at. The page also carries a summary with account totals (total, active, unverified, inactive, admins, moderators).", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "q", "in": "query", "required": false, "description": "Matches name, username or email.", "schema": {"type": "string"}}, {"name": "role", "in": "query", "required": false, "schema": {"type": "string", "enum": ["user", "moderator", "admin"]}}, {"name": "status", "in": "query", "required": false, "description": "inactive = deactivated; unverified = active without a verified email; active = active and verified.", "schema": {"type": "string", "enum": ["active", "unverified", "inactive"]}}, {"name": "page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1}}, {"name": "per_page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 50}}], "responses": {"200": {"description": "A page of users."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins and moderators only."}, "422": {"description": "Validation failed."}}}
    },
    "/api/admin/users/{user}": {
      "patch": {"summary": "Change a user's role or active state (admins; moderators may only suspend or reinstate members)", "description": "Deactivating a user signs them out everywhere. Admins cannot demote or deactivate themselves. Moderators may send only is_active, and only for accounts whose role is user; they cannot change roles or touch admins, other moderators or themselves.", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "user", "in": "path", "required": true, "schema": {"type": "integer"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"role": {"type": "string", "enum": ["user", "moderator", "admin"]}, "is_active": {"type": "boolean"}}}}}}, "responses": {"200": {"description": "User updated."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins and moderators only, or the target is not allowed (own account, or a moderator acting on a role change or on an admin or moderator)."}, "404": {"description": "User not found."}, "422": {"description": "Validation failed."}}},
      "delete": {"summary": "Delete a user", "description": "Admins cannot delete themselves.", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "user", "in": "path", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "User deleted."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins only, or the admin targeted their own account."}, "404": {"description": "User not found."}}}
    },
    "/api/admin/reviews": {
      "get": {"summary": "List reviews to moderate (admins and moderators)", "description": "Reviews with text, plus removed ones (their text is gone). Each has status (flagged = unresolved reports, approved, pending, removed), reports_count, reasons, rating, sentiment and movie info. The page carries a summary with flagged and removed counts and the sentiment split.", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "q", "in": "query", "description": "Case-insensitive search in review text, author name or username, applied before pagination.", "schema": {"type": "string", "maxLength": 200}}, {"name": "sentiment", "in": "query", "schema": {"type": "string", "enum": ["positive", "neutral", "negative"]}}, {"name": "reason", "in": "query", "schema": {"type": "string", "enum": ["Spam", "Links", "Spoilers", "Offensive language", "offensive language", "spoiler", "spam", "awaiting classification"]}}, {"name": "status", "in": "query", "required": false, "description": "Defaults to pending.", "schema": {"type": "string", "enum": ["pending", "approved", "flagged", "removed"]}}, {"name": "page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1}}, {"name": "per_page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 50}}], "responses": {"200": {"description": "A page of reviews."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins only."}, "422": {"description": "Validation failed."}}}
    },
    "/api/admin/reviews/{review}": {
      "patch": {"summary": "Approve or reject a review (admins and moderators)", "description": "Rejecting removes the text, marks the review removed and keeps the member's star rating. Either decision closes the review's open reports.", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "review", "in": "path", "required": true, "schema": {"type": "integer"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string", "enum": ["approved", "rejected"]}}}}}}, "responses": {"200": {"description": "Review moderated."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins only."}, "404": {"description": "Review not found."}, "422": {"description": "Validation failed."}}},
      "delete": {"summary": "Delete a review", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "review", "in": "path", "required": true, "schema": {"type": "integer"}}], "responses": {"200": {"description": "Review deleted."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins only."}, "404": {"description": "Review not found."}}}
    },
    "/api/admin/movies": {
      "get": {"summary": "List the local movie catalogue", "description": "Each film has director, runtime, release_date, genre_ids and is_edited. The page carries summary.sync with cached, overrides and last_synced_at.", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "q", "in": "query", "required": false, "description": "Matches the title.", "schema": {"type": "string"}}, {"name": "page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1}}, {"name": "per_page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 50}}], "responses": {"200": {"description": "A page of local movies."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins only."}, "422": {"description": "Validation failed."}}}
    },
    "/api/admin/movies/{tmdbId}": {
      "patch": {"summary": "Hide, feature or edit a local movie", "description": "Editing title, overview, director, runtime, release_date or genre_ids marks the film as edited. null clears overview, director, runtime and release_date; an empty genre_ids clears the genres.", "tags": ["Admin"], "security": [{"cookieAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "tmdbId", "in": "path", "required": true, "schema": {"type": "integer"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"title": {"type": "string"}, "overview": {"type": "string", "nullable": true}, "director": {"type": "string", "nullable": true}, "runtime": {"type": "integer", "minimum": 1, "maximum": 1000, "nullable": true}, "release_date": {"type": "string", "format": "date", "nullable": true}, "genre_ids": {"type": "array", "items": {"type": "integer"}}, "is_hidden": {"type": "boolean"}, "is_featured": {"type": "boolean"}}}}}}, "responses": {"200": {"description": "Movie updated."}, "401": {"description": "Not authenticated."}, "403": {"description": "Admins only."}, "404": {"description": "The film is not in the local catalogue."}, "422": {"description": "Validation failed."}}}
    }
  }
}
