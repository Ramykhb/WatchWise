{
    "paths": {
        "/api/rooms": {
            "get": {
                "summary": "List discussion rooms",
                "description": "Every room, the ones you are a member of first. `members` are the creator and everyone who has posted; `message_count`, `last_message` and `unread` only count messages that are still stored (someone has yet to read them).",
                "tags": ["Rooms"],
                "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
                "responses": {
                    "200": {
                        "description": "The rooms.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "rooms": { "type": "array", "items": { "$ref": "#/components/schemas/Room" } }
                                    }
                                }
                            }
                        }
                    },
                    "401": { "description": "Not signed in." }
                }
            },
            "post": {
                "summary": "Create a discussion room",
                "description": "The creator becomes the room's first member.",
                "tags": ["Rooms"],
                "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["name", "tmdb_id"],
                                "properties": {
                                    "name": { "type": "string", "minLength": 3, "maxLength": 80 },
                                    "tmdb_id": { "type": "integer", "minimum": 1 },
                                    "spoilers": { "type": "boolean" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Room created.",
                        "content": {
                            "application/json": {
                                "schema": { "type": "object", "properties": { "room": { "$ref": "#/components/schemas/Room" } } }
                            }
                        }
                    },
                    "401": { "description": "Not signed in." },
                    "422": { "description": "Invalid input.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } } }
                }
            }
        },
        "/api/rooms/{room}/messages": {
            "parameters": [{ "name": "room", "in": "path", "required": true, "schema": { "type": "integer" } }],
            "get": {
                "summary": "Messages someone still has to read",
                "description": "A message is stored only until every member at the time it was sent has read it, so this lists the pending ones, oldest first, each with `read_by` (the author first) and `unread_by`. Opening a room does not mark anything read; the browser confirms with `POST /api/rooms/{room}/read`.",
                "tags": ["Rooms"],
                "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
                "responses": {
                    "200": {
                        "description": "The stored messages.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "messages": { "type": "array", "items": { "$ref": "#/components/schemas/RoomMessage" } }
                                    }
                                }
                            }
                        }
                    },
                    "401": { "description": "Not signed in." },
                    "404": { "description": "Unknown room." }
                }
            },
            "post": {
                "summary": "Send a message to a room",
                "description": "Posting makes the sender a member. The message counts as read by the sender and waits for every other member; it is pushed as `message.sent` on the private channel `room.{room}` to everyone who has the room open. With no other members it is not kept.",
                "tags": ["Rooms"],
                "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["content"],
                                "properties": { "content": { "type": "string", "maxLength": 1000 } }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Message sent.",
                        "content": {
                            "application/json": {
                                "schema": { "type": "object", "properties": { "message": { "$ref": "#/components/schemas/RoomMessage" } } }
                            }
                        }
                    },
                    "401": { "description": "Not signed in." },
                    "404": { "description": "Unknown room." },
                    "422": { "description": "Empty or too long.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } } },
                    "429": { "description": "More than 30 messages a minute." }
                }
            }
        },
        "/api/rooms/{room}/read": {
            "parameters": [{ "name": "room", "in": "path", "required": true, "schema": { "type": "integer" } }],
            "post": {
                "summary": "Mark room messages as read",
                "description": "The signed-in member has seen these messages (the room was open). Ids that are not waiting for this member are ignored. Messages every member has now read are deleted and listed in `deleted_ids`; a `messages.read` event tells everyone who has the room open.",
                "tags": ["Rooms"],
                "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["message_ids"],
                                "properties": {
                                    "message_ids": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "type": "integer", "minimum": 1 } }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Read receipts saved.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message_ids": { "type": "array", "items": { "type": "integer" } },
                                        "deleted_ids": { "type": "array", "items": { "type": "integer" } }
                                    }
                                }
                            }
                        }
                    },
                    "401": { "description": "Not signed in." },
                    "404": { "description": "Unknown room." },
                    "422": { "description": "Invalid ids.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } } }
                }
            }
        },
        "/api/rooms/socket-auth": {
            "post": {
                "summary": "Authorize a room's socket channel",
                "description": "Pusher-protocol authorization for the private channel `private-room.{id}` on Reverb (connection settings come from `GET /api/chat/connection`).",
                "tags": ["Rooms"],
                "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["socket_id", "channel_name"],
                                "properties": {
                                    "socket_id": { "type": "string", "example": "123.456" },
                                    "channel_name": { "type": "string", "example": "private-room.3" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Channel signature.",
                        "content": { "application/json": { "schema": { "type": "object", "properties": { "auth": { "type": "string" } } } } }
                    },
                    "401": { "description": "Not signed in." },
                    "403": { "description": "Unknown room." },
                    "422": { "description": "Not a room channel.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } } }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "RoomMember": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer" },
                    "username": { "type": "string" },
                    "name": { "type": "string" },
                    "avatar": { "type": "string", "nullable": true }
                }
            },
            "Room": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer" },
                    "name": { "type": "string" },
                    "tmdb_id": { "type": "integer" },
                    "spoilers": { "type": "boolean" },
                    "host": { "allOf": [{ "$ref": "#/components/schemas/RoomMember" }], "nullable": true },
                    "members": { "type": "array", "items": { "$ref": "#/components/schemas/RoomMember" } },
                    "joined": { "type": "boolean" },
                    "message_count": { "type": "integer" },
                    "unread": { "type": "integer" },
                    "last_message": {
                        "type": "object",
                        "nullable": true,
                        "properties": {
                            "author": { "type": "string", "nullable": true },
                            "content": { "type": "string" },
                            "created_at": { "type": "string", "format": "date-time" }
                        }
                    },
                    "created_at": { "type": "string", "format": "date-time" }
                }
            },
            "RoomMessage": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer" },
                    "room_id": { "type": "integer" },
                    "user": { "$ref": "#/components/schemas/RoomMember" },
                    "content": { "type": "string" },
                    "created_at": { "type": "string", "format": "date-time" },
                    "read_by": { "type": "array", "items": { "$ref": "#/components/schemas/RoomMember" } },
                    "unread_by": { "type": "array", "items": { "$ref": "#/components/schemas/RoomMember" } }
                }
            }
        }
    }
}
