{
    "paths": {
        "/api/rooms": {
            "get": {
                "summary": "List discussion rooms",
                "description": "The rooms you can see: every public room, and the private rooms you are a member of or invited to. Yours come first, then invitations, then the other public rooms, newest activity first. `members` are the creator and everyone who joined; `message_count` and `last_message` describe the messages you can still see (a message is shown for 24 hours after it is sent, then only to the members who have yet to read it), and `unread` counts the ones waiting for you. The list is kept current over the private channels `rooms.public` and `rooms.user.{your id}`: `message.sent` carries a new message, `rooms.changed` (`room_id`) means reload.",
                "tags": ["Rooms"],
                "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
                "responses": {
                    "200": {
                        "description": "The rooms.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "rooms": { "type": "array", "items": { "$ref": "#/components/schemas/Room" } }
                                    }
                                }
                            }
                        }
                    },
                    "401": { "description": "Not signed in." }
                }
            },
            "post": {
                "summary": "Create a discussion room",
                "description": "The creator becomes the room's first member. A public room (the default) can be read and joined by anyone and is announced as `rooms.changed` on `rooms.public`; a private one is seen only by its members and the people they invite.",
                "tags": ["Rooms"],
                "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["name", "tmdb_id"],
                                "properties": {
                                    "name": { "type": "string", "minLength": 3, "maxLength": 80 },
                                    "tmdb_id": { "type": "integer", "minimum": 1 },
                                    "spoilers": { "type": "boolean" },
                                    "is_private": { "type": "boolean", "default": false }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Room created.",
                        "content": {
                            "application/json": {
                                "schema": { "type": "object", "properties": { "room": { "$ref": "#/components/schemas/Room" } } }
                            }
                        }
                    },
                    "401": { "description": "Not signed in." },
                    "422": { "description": "Invalid input.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } } }
                }
            }
        },
        "/api/rooms/{room}/join": {
            "parameters": [{ "name": "room", "in": "path", "required": true, "schema": { "type": "integer" } }],
            "post": {
                "summary": "Join a room",
                "description": "Joins a public room, or accepts your invitation to a private one (the invitation is removed). Messages sent from now on wait for you too; older ones do not. Pushes `rooms.changed` to the lists that show the room.",
                "tags": ["Rooms"],
                "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
                "responses": {
                    "200": {
                        "description": "You are a member.",
                        "content": {
                            "application/json": {
                                "schema": { "type": "object", "properties": { "room": { "$ref": "#/components/schemas/Room" } } }
                            }
                        }
                    },
                    "401": { "description": "Not signed in." },
                    "403": { "description": "A private room you are not invited to." },
                    "404": { "description": "Unknown room." }
                }
            }
        },
        "/api/rooms/{room}/invites": {
            "parameters": [{ "name": "room", "in": "path", "required": true, "schema": { "type": "integer" } }],
            "post": {
                "summary": "Invite people to a private room",
                "description": "Any member of a private room can invite people by username; members and people already invited are skipped. Invitees see the room and can read it, then join or decline. Pushes `rooms.changed` to the members and invitees.",
                "tags": ["Rooms"],
                "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["invitees"],
                                "properties": {
                                    "invitees": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "description": "A username." } }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The room with its invitees.",
                        "content": {
                            "application/json": {
                                "schema": { "type": "object", "properties": { "room": { "$ref": "#/components/schemas/Room" } } }
                            }
                        }
                    },
                    "401": { "description": "Not signed in." },
                    "403": { "description": "A public room, or you are not a member." },
                    "404": { "description": "Unknown room." },
                    "422": { "description": "Unknown usernames.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } } },
                    "429": { "description": "More than 30 invitations a minute." }
                }
            }
        },
        "/api/rooms/{room}/invite": {
            "parameters": [{ "name": "room", "in": "path", "required": true, "schema": { "type": "integer" } }],
            "delete": {
                "summary": "Decline an invitation",
                "description": "Turns down your invitation to a private room, which then disappears from your list. Pushes `rooms.changed` to the members, the other invitees and you.",
                "tags": ["Rooms"],
                "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
                "responses": {
                    "200": {
                        "description": "Invitation declined.",
                        "content": { "application/json": { "schema": { "type": "object", "properties": { "message": { "type": "string" } } } } }
                    },
                    "401": { "description": "Not signed in." },
                    "403": { "description": "You are not invited to this room." },
                    "404": { "description": "Unknown room." }
                }
            }
        },
        "/api/rooms/{room}/messages": {
            "parameters": [{ "name": "room", "in": "path", "required": true, "schema": { "type": "integer" } }],
            "get": {
                "summary": "Messages you can still see",
                "description": "Anyone who can see the room can read it: everyone for a public room, the members and invitees of a private one. A message is stored and shown to everyone for 24 hours after it is sent; after that only the members (at the time it was sent) who have yet to read it still get it, and it is deleted once none of them still has to. So this lists the messages you can still see, oldest first, each with `read_by` (the author first) and `unread_by`. Opening a room does not mark anything read; the browser confirms with `POST /api/rooms/{room}/read`.",
                "tags": ["Rooms"],
                "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
                "responses": {
                    "200": {
                        "description": "The messages you can still see.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "messages": { "type": "array", "items": { "$ref": "#/components/schemas/RoomMessage" } }
                                    }
                                }
                            }
                        }
                    },
                    "401": { "description": "Not signed in." },
                    "403": { "description": "A private room you are not a member of or invited to." },
                    "404": { "description": "Unknown room." }
                }
            },
            "post": {
                "summary": "Send a message to a room",
                "description": "Only members post (join first). The message counts as read by the sender and waits for every other member; it is pushed as `message.sent` on the private channel `room.{room}` to everyone who has the room open, and on the room-list channels (`rooms.public`, or `rooms.user.{id}` of each member and invitee of a private room). It is kept for 24 hours even with no other members, and after that until every other member has read it.",
                "tags": ["Rooms"],
                "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["content"],
                                "properties": { "content": { "type": "string", "maxLength": 1000 } }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Message sent.",
                        "content": {
                            "application/json": {
                                "schema": { "type": "object", "properties": { "message": { "$ref": "#/components/schemas/RoomMessage" } } }
                            }
                        }
                    },
                    "401": { "description": "Not signed in." },
                    "403": { "description": "You are not a member of the room." },
                    "404": { "description": "Unknown room." },
                    "422": { "description": "Empty or too long.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } } },
                    "429": { "description": "More than 30 messages a minute." }
                }
            }
        },
        "/api/rooms/{room}/read": {
            "parameters": [{ "name": "room", "in": "path", "required": true, "schema": { "type": "integer" } }],
            "post": {
                "summary": "Mark room messages as read",
                "description": "The signed-in member has seen these messages (the room was open). Ids that are not waiting for this member are ignored, so reading a room you have not joined counts for nothing. Messages past their 24 hours that every member has now read are deleted and listed in `deleted_ids` (ones read by everyone within their 24 hours are deleted when those are up, by the scheduled `rooms:prune-messages`); a `messages.read` event tells everyone who has the room open.",
                "tags": ["Rooms"],
                "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["message_ids"],
                                "properties": {
                                    "message_ids": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "type": "integer", "minimum": 1 } }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Read receipts saved.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message_ids": { "type": "array", "items": { "type": "integer" } },
                                        "deleted_ids": { "type": "array", "items": { "type": "integer" } }
                                    }
                                }
                            }
                        }
                    },
                    "401": { "description": "Not signed in." },
                    "403": { "description": "A private room you are not a member of or invited to." },
                    "404": { "description": "Unknown room." },
                    "422": { "description": "Invalid ids.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } } }
                }
            }
        },
        "/api/rooms/socket-auth": {
            "post": {
                "summary": "Authorize a room's socket channel",
                "description": "Pusher-protocol authorization on Reverb (connection settings come from `GET /api/chat/connection`) for the Rooms page's private channels: `private-room.{id}` (anyone who can see the room), `private-rooms.public` (everyone) and `private-rooms.user.{id}` (only that user).",
                "tags": ["Rooms"],
                "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["socket_id", "channel_name"],
                                "properties": {
                                    "socket_id": { "type": "string", "example": "123.456" },
                                    "channel_name": { "type": "string", "example": "private-room.3" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Channel signature.",
                        "content": { "application/json": { "schema": { "type": "object", "properties": { "auth": { "type": "string" } } } } }
                    },
                    "401": { "description": "Not signed in." },
                    "403": { "description": "Unknown room, a private room you cannot see, or another user's list channel." },
                    "422": { "description": "Not a room channel.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } } }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "RoomMember": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer" },
                    "username": { "type": "string" },
                    "name": { "type": "string" },
                    "avatar": { "type": "string", "nullable": true }
                }
            },
            "Room": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer" },
                    "name": { "type": "string" },
                    "tmdb_id": { "type": "integer" },
                    "spoilers": { "type": "boolean" },
                    "is_private": { "type": "boolean" },
                    "host": { "allOf": [{ "$ref": "#/components/schemas/RoomMember" }], "nullable": true },
                    "members": { "type": "array", "items": { "$ref": "#/components/schemas/RoomMember" } },
                    "joined": { "type": "boolean" },
                    "invited": { "type": "boolean", "description": "You are invited to this private room and have not answered yet." },
                    "invited_by": { "allOf": [{ "$ref": "#/components/schemas/RoomMember" }], "nullable": true },
                    "invitees": { "type": "array", "items": { "$ref": "#/components/schemas/RoomMember" }, "description": "People invited who have not joined or declined yet." },
                    "message_count": { "type": "integer" },
                    "unread": { "type": "integer" },
                    "last_message": {
                        "type": "object",
                        "nullable": true,
                        "properties": {
                            "author": { "type": "string", "nullable": true },
                            "content": { "type": "string" },
                            "created_at": { "type": "string", "format": "date-time" }
                        }
                    },
                    "created_at": { "type": "string", "format": "date-time" }
                }
            },
            "RoomMessage": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer" },
                    "room_id": { "type": "integer" },
                    "user": { "$ref": "#/components/schemas/RoomMember" },
                    "content": { "type": "string" },
                    "created_at": { "type": "string", "format": "date-time" },
                    "read_by": { "type": "array", "items": { "$ref": "#/components/schemas/RoomMember" } },
                    "unread_by": { "type": "array", "items": { "$ref": "#/components/schemas/RoomMember" } }
                }
            }
        }
    }
}
