{
  "paths": {
    "/api/movies": {
      "get": {
        "summary": "List movies (popular, top rated, now playing, upcoming)",
        "description": "Returns one page of a TMDB movie list. Requires TMDB_API_KEY in .env. Limited to 60 requests per minute.",
        "tags": ["Movies"],
        "parameters": [
          {"name": "list", "in": "query", "required": false, "description": "Which list to fetch.", "schema": {"type": "string", "enum": ["popular", "top_rated", "now_playing", "upcoming"], "default": "popular"}},
          {"name": "page", "in": "query", "required": false, "description": "Page number.", "schema": {"type": "integer", "minimum": 1, "maximum": 500, "default": 1}}
        ],
        "responses": {
          "200": {
            "description": "A page of movies. The response also echoes the requested list name.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MovieListPage"}}}
          },
          "422": {"description": "Validation failed.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ValidationError"}}}},
          "429": {"description": "Too many requests.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}}}},
          "502": {"description": "TMDB is unreachable or returned an error.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}, "example": {"message": "Movie service is temporarily unavailable."}}}}
        }
      }
    },
    "/api/movies/search": {
      "get": {
        "summary": "Search movies by title",
        "description": "Searches TMDB movies by title. Requires TMDB_API_KEY in .env. Limited to 60 requests per minute.",
        "tags": ["Movies"],
        "parameters": [
          {"name": "q", "in": "query", "required": true, "description": "Search text.", "schema": {"type": "string", "minLength": 1, "maxLength": 100}, "example": "inception"},
          {"name": "page", "in": "query", "required": false, "description": "Page number.", "schema": {"type": "integer", "minimum": 1, "maximum": 500, "default": 1}},
          {"name": "year", "in": "query", "required": false, "description": "Restrict to a release year.", "schema": {"type": "integer", "minimum": 1874, "maximum": 2100}, "example": 2010}
        ],
        "responses": {
          "200": {
            "description": "A page of matching movies. The response also echoes the query.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MovieSearchPage"}}}
          },
          "422": {"description": "Validation failed.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ValidationError"}}}},
          "429": {"description": "Too many requests.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}}}},
          "502": {"description": "TMDB is unreachable or returned an error.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}, "example": {"message": "Movie service is temporarily unavailable."}}}}
        }
      }
    },
    "/api/movies/discover": {
      "get": {
        "summary": "Browse movies with filters",
        "description": "Browses TMDB movies with Discover filters. All filters are optional. year_to must be >= year_from and runtime_max >= runtime_min when both are sent. Requires TMDB_API_KEY in .env. Limited to 60 requests per minute.",
        "tags": ["Movies"],
        "parameters": [
          {"name": "genres", "in": "query", "required": false, "description": "Comma separated TMDB genre ids (see GET /api/genres).", "schema": {"type": "string", "pattern": "^\\d+(,\\d+)*$"}, "example": "28,12"},
          {"name": "year_from", "in": "query", "required": false, "description": "Earliest release year.", "schema": {"type": "integer", "minimum": 1874, "maximum": 2100}, "example": 2000},
          {"name": "year_to", "in": "query", "required": false, "description": "Latest release year.", "schema": {"type": "integer", "minimum": 1874, "maximum": 2100}, "example": 2020},
          {"name": "min_rating", "in": "query", "required": false, "description": "Minimum rating on the 0-5 scale.", "schema": {"type": "number", "minimum": 0, "maximum": 5}, "example": 3.5},
          {"name": "runtime_min", "in": "query", "required": false, "description": "Minimum runtime in minutes.", "schema": {"type": "integer", "minimum": 0}, "example": 90},
          {"name": "runtime_max", "in": "query", "required": false, "description": "Maximum runtime in minutes.", "schema": {"type": "integer", "minimum": 1}, "example": 180},
          {"name": "language", "in": "query", "required": false, "description": "Original language, 2-letter lowercase code.", "schema": {"type": "string", "pattern": "^[a-z]{2}$"}, "example": "en"},
          {"name": "sort", "in": "query", "required": false, "description": "Sort order.", "schema": {"type": "string", "enum": ["popularity", "rating", "release_date", "title"], "default": "popularity"}},
          {"name": "page", "in": "query", "required": false, "description": "Page number.", "schema": {"type": "integer", "minimum": 1, "maximum": 500, "default": 1}}
        ],
        "responses": {
          "200": {
            "description": "A page of movies. The response also echoes the sort order.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MovieDiscoverPage"}}}
          },
          "422": {"description": "Validation failed.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ValidationError"}}}},
          "429": {"description": "Too many requests.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}}}},
          "502": {"description": "TMDB is unreachable or returned an error.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}, "example": {"message": "Movie service is temporarily unavailable."}}}}
        }
      }
    },
    "/api/movies/{id}": {
      "get": {
        "summary": "Get movie details",
        "description": "Returns a movie with its genres, cast, directors, trailer, certification and recommended movies. Successful responses are cached for six hours. Requires TMDB_API_KEY in .env. Limited to 60 requests per minute.",
        "tags": ["Movies"],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "description": "TMDB movie id.", "schema": {"type": "integer", "minimum": 1}, "example": 27205}
        ],
        "responses": {
          "200": {"description": "Movie details.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MovieDetails"}}}},
          "404": {"description": "No movie has this id.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}, "example": {"message": "Movie not found."}}}},
          "429": {"description": "Too many requests.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}}}},
          "502": {"description": "TMDB is unreachable or returned an error.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}, "example": {"message": "Movie service is temporarily unavailable."}}}}
        }
      }
    },
    "/api/genres": {
      "get": {
        "summary": "List movie genres",
        "description": "Returns TMDB's movie genres (cached for a day). Requires TMDB_API_KEY in .env. Limited to 60 requests per minute.",
        "tags": ["Genres"],
        "responses": {
          "200": {
            "description": "All genres.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GenreList"}, "example": {"genres": [{"id": 28, "name": "Action"}, {"id": 12, "name": "Adventure"}]}}}
          },
          "429": {"description": "Too many requests.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}}}},
          "502": {"description": "TMDB is unreachable or returned an error.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}, "example": {"message": "Movie service is temporarily unavailable."}}}}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Movie": {
        "type": "object",
        "required": ["id", "title", "overview", "release_date", "year", "rating", "vote_count", "genre_ids", "poster_url", "backdrop_url"],
        "properties": {
          "id": {"type": "integer", "example": 27205},
          "title": {"type": "string", "example": "Inception"},
          "overview": {"type": "string"},
          "release_date": {"type": "string", "nullable": true, "example": "2010-07-15"},
          "year": {"type": "integer", "nullable": true, "example": 2010},
          "rating": {"type": "number", "format": "float", "minimum": 0, "maximum": 5, "example": 4.2},
          "vote_count": {"type": "integer", "example": 35000},
          "genre_ids": {"type": "array", "items": {"type": "integer"}, "example": [28, 878, 12]},
          "poster_url": {"type": "string", "nullable": true},
          "backdrop_url": {"type": "string", "nullable": true}
        }
      },
      "MoviePageBase": {
        "type": "object",
        "required": ["page", "total_pages", "total_results", "movies"],
        "properties": {
          "page": {"type": "integer", "example": 1},
          "total_pages": {"type": "integer", "maximum": 500, "example": 500},
          "total_results": {"type": "integer", "example": 10000},
          "movies": {"type": "array", "items": {"$ref": "#/components/schemas/Movie"}}
        }
      },
      "MovieListPage": {
        "allOf": [
          {"type": "object", "required": ["list"], "properties": {"list": {"type": "string", "enum": ["popular", "top_rated", "now_playing", "upcoming"], "example": "popular"}}},
          {"$ref": "#/components/schemas/MoviePageBase"}
        ]
      },
      "MovieSearchPage": {
        "allOf": [
          {"type": "object", "required": ["query"], "properties": {"query": {"type": "string", "example": "inception"}}},
          {"$ref": "#/components/schemas/MoviePageBase"}
        ]
      },
      "MovieDiscoverPage": {
        "allOf": [
          {"type": "object", "required": ["sort"], "properties": {"sort": {"type": "string", "enum": ["popularity", "rating", "release_date", "title"], "example": "popularity"}}},
          {"$ref": "#/components/schemas/MoviePageBase"}
        ]
      },
      "MovieDetails": {
        "allOf": [
          {"$ref": "#/components/schemas/Movie"},
          {
            "type": "object",
            "required": ["genres", "tagline", "runtime", "status", "tmdb_score", "original_language", "certification", "budget", "revenue", "directors", "cast", "trailer", "similar"],
            "properties": {
              "genres": {"type": "array", "items": {"$ref": "#/components/schemas/Genre"}},
              "tagline": {"type": "string", "nullable": true},
              "runtime": {"type": "integer", "nullable": true, "example": 148},
              "status": {"type": "string", "nullable": true, "example": "Released"},
              "tmdb_score": {"type": "number", "format": "float", "example": 8.3},
              "original_language": {"type": "object", "nullable": true, "required": ["code", "name"], "properties": {"code": {"type": "string"}, "name": {"type": "string"}}},
              "certification": {"type": "string", "nullable": true, "example": "PG-13"},
              "budget": {"type": "integer", "nullable": true},
              "revenue": {"type": "integer", "nullable": true},
              "directors": {"type": "array", "items": {"$ref": "#/components/schemas/Person"}},
              "cast": {"type": "array", "items": {"$ref": "#/components/schemas/CastMember"}},
              "trailer": {"type": "object", "nullable": true, "required": ["name", "youtube_key", "url", "embed_url"], "properties": {"name": {"type": "string"}, "youtube_key": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "embed_url": {"type": "string", "format": "uri"}}},
              "similar": {"type": "array", "items": {"$ref": "#/components/schemas/Movie"}}
            }
          }
        ]
      },
      "Person": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {"id": {"type": "integer"}, "name": {"type": "string"}}
      },
      "CastMember": {
        "type": "object",
        "required": ["id", "name", "character", "profile_url"],
        "properties": {"id": {"type": "integer"}, "name": {"type": "string"}, "character": {"type": "string"}, "profile_url": {"type": "string", "nullable": true}}
      },
      "Trailer": {
        "type": "object",
        "required": ["name", "youtube_key", "url", "embed_url"],
        "properties": {"name": {"type": "string"}, "youtube_key": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "embed_url": {"type": "string", "format": "uri"}}
      },
      "Genre": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "integer", "example": 28},
          "name": {"type": "string", "example": "Action"}
        }
      },
      "GenreList": {
        "type": "object",
        "required": ["genres"],
        "properties": {
          "genres": {"type": "array", "items": {"$ref": "#/components/schemas/Genre"}}
        }
      }
    }
  }
}
