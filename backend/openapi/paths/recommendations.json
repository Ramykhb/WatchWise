{
  "paths": {
    "/api/watched-recommendations": {
      "get": {
        "summary": "Get recommendations based on your watched history",
        "description": "Picks a random movie or TV show marked watched by the authenticated user. Groq selects six matching titles from verified TMDB candidates, excluding watched titles and other editions with the same title as the watched source. Fewer are returned only when fewer candidates exist. Empty history returns source null and an empty movies array. Successful results are cached per user for one hour and invalidated when the watched list changes. Requires TMDB_API_KEY and the separate GROQ_API_KEY_2 for watched-history recommendations (same GROQ_MODEL and GROQ_API_URL). Counts against the AI limit of 10 requests per minute.",
        "tags": [
          "Recommendations"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Watched source and Groq-selected TMDB titles.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "source",
                    "movies"
                  ],
                  "properties": {
                    "source": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/Movie"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "movies": {
                      "type": "array",
                      "maxItems": 6,
                      "items": {
                        "$ref": "#/components/schemas/RecommendedMovie"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated."
          },
          "429": {
            "description": "Too many requests."
          },
          "502": {
            "description": "TMDB or Groq unavailable, or invalid AI selection."
          }
        }
      }
    },
    "/api/movie-recommendations": {
      "get": {
        "summary": "Get movie recommendations for the current weather",
        "description": "Fetches the current weather, retrieves popular TMDB candidates in weather-appropriate genres, then asks Gemini to select up to 10 candidates. Only verified TMDB movies are returned. Send latitude and longitude together, or neither to use the default location. Requires TMDB_API_KEY and GEMINI_API_KEY in .env. Counts against the AI limit of 10 requests per minute.",
        "tags": ["Recommendations"],
        "parameters": [
          {"name": "latitude", "in": "query", "required": false, "description": "Required if longitude is sent.", "schema": {"type": "number", "minimum": -90, "maximum": 90}, "example": 33.8938},
          {"name": "longitude", "in": "query", "required": false, "description": "Required if latitude is sent.", "schema": {"type": "number", "minimum": -180, "maximum": 180}, "example": 35.5018}
        ],
        "responses": {
          "200": {
            "description": "Weather-matched TMDB movies with Gemini's reason for each selection. Up to 10 movies may be returned.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RecommendationResponse"}}}
          },
          "422": {"description": "Validation failed.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ValidationError"}}}},
          "429": {"description": "Too many requests.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}}}},
          "502": {
            "description": "The weather, TMDB, or Gemini step failed.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"},
                "examples": {
                  "weather": {"summary": "Weather lookup failed", "value": {"error": "Could not get the weather"}},
                  "gemini": {"summary": "Gemini failed", "value": {"error": "Could not generate recommendations"}}
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RecommendedMovie": {
        "type": "object",
        "required": ["id", "media_type", "title", "overview", "release_date", "year", "rating", "vote_count", "genre_ids", "poster_url", "backdrop_url", "reason"],
        "properties": {
          "id": {"type": "integer", "example": 872585},
          "media_type": {"type": "string", "enum": ["movie", "tv"], "example": "movie"},
          "title": {"type": "string", "example": "Singin' in the Rain"},
          "overview": {"type": "string", "example": "A brief movie synopsis."},
          "release_date": {"type": ["string", "null"], "example": "1952-04-11"},
          "year": {"type": ["integer", "null"], "example": 1952},
          "rating": {"type": "number", "example": 4.1},
          "vote_count": {"type": "integer", "example": 1200},
          "genre_ids": {"type": "array", "items": {"type": "integer"}},
          "poster_url": {"type": ["string", "null"], "example": "https://image.tmdb.org/t/p/w500/example.jpg"},
          "backdrop_url": {"type": ["string", "null"], "example": "https://image.tmdb.org/t/p/w1280/example.jpg"},
          "reason": {"type": "string", "example": "A feel-good classic that suits a rainy day."}
        }
      },
      "RecommendationResponse": {
        "type": "object",
        "required": ["movies"],
        "properties": {
          "movies": {"type": "array", "description": "Selected movies are resolved from the TMDB candidate set; unknown IDs and duplicates are discarded. Up to 10 can be returned.", "items": {"$ref": "#/components/schemas/RecommendedMovie"}}
        }
      }
    }
  }
}
