{
  "paths": {
    "/api/chat/connection": {
      "get": {
        "summary": "Get chat WebSocket settings",
        "description": "Public Reverb connection settings and context limits. No Groq key or socket secret is returned.",
        "tags": [
          "Chat"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Public settings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "host": {
                      "type": "string"
                    },
                    "port": {
                      "type": "integer"
                    },
                    "scheme": {
                      "type": "string",
                      "enum": [
                        "http",
                        "https"
                      ]
                    },
                    "max_message_chars": {
                      "type": "integer"
                    },
                    "max_history_messages": {
                      "type": "integer"
                    },
                    "max_history_chars": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated."
          },
          "429": {
            "description": "Too many requests."
          }
        }
      }
    },
    "/api/chat/auth": {
      "post": {
        "summary": "Authorize a private chat socket channel",
        "description": "Only private-chat.{authenticated user id}.{conversation UUID} channels are authorized using the existing JWT cookie or Bearer token. Reverb speaks the Pusher protocol at ws(s)://{host}:{port}/app/{key}.",
        "tags": [
          "Chat"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "socket_id",
                  "channel_name"
                ],
                "properties": {
                  "socket_id": {
                    "type": "string",
                    "example": "123.456"
                  },
                  "channel_name": {
                    "type": "string",
                    "example": "private-chat.1.019ac853-70ed-72d5-a27a-a75b2ab324a1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed private-channel authorization.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "auth": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated."
          },
          "403": {
            "description": "Channel belongs to another user or the conversation ID is invalid."
          },
          "422": {
            "description": "Validation failed."
          },
          "429": {
            "description": "Too many requests."
          }
        }
      }
    },
    "/api/chat/messages": {
      "post": {
        "summary": "Send a history-aware chat message",
        "description": "Subscribe to private-chat.{user id}.{conversation_id} first. Reply text streams as chat.delta events containing request_id and delta. The HTTP response returns the authoritative complete answer. No transcripts are persisted and no queue worker is required. History must contain completed alternating user/assistant pairs: at most 20 messages, 8000 characters per message and 24000 characters total. The server supplies the system prompt. Limit: 10 requests/minute and 100/hour per user. Discard failed partial replies from history.",
        "tags": [
          "Chat"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message",
                  "conversation_id",
                  "request_id"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "conversation_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "request_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "history": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "user",
                            "assistant"
                          ]
                        },
                        "content": {
                          "type": "string",
                          "maxLength": 8000
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete assistant reply; replaces any streamed draft.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "request_id",
                    "message"
                  ],
                  "properties": {
                    "request_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated."
          },
          "422": {
            "description": "Validation failed."
          },
          "429": {
            "description": "Too many requests."
          },
          "502": {
            "description": "Groq or the broadcaster failed. Partial streamed replies are incomplete.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        }
      }
    }
  }
}
