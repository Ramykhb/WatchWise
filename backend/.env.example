APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
OPEN_METEO_DEFAULT_LATITUDE=33.8938
OPEN_METEO_DEFAULT_LONGITUDE=35.5018
OPEN_METEO_TIMEZONE=Asia/Beirut
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# Google Places API key for nearby cinema search.
GOOGLE_PLACES_API_KEY=your_key_here

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=database/database.sqlite
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- SMTP: replace every CHANGE_ME value and smtp.example.com with real credentials ---
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME=WatchWise

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Frontend base URL used for links in emails and social-login redirects
FRONTEND_URL=http://localhost:5173

# Social login - fill from each provider's developer console
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/social/google/callback
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/social/github/callback
DISCORD_CLIENT_ID=CHANGE_ME
DISCORD_CLIENT_SECRET=CHANGE_ME
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/social/discord/callback

JWT_SECRET=
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL_DAYS=30

TMDB_URL=https://api.themoviedb.org/3
TMDB_IMAGE_URL=https://image.tmdb.org/t/p
TMDB_API_KEY=your_key_here

# Groq (weather mood; GPT-OSS 20B is the default model). GROQ_MODEL and GROQ_API_URL are optional.
GROQ_API_KEY=your_key_here
# GROQ_MODEL=openai/gpt-oss-20b

# Chat sockets: generate credentials with `php artisan reverb:install` once.
# `php artisan serve` starts Reverb automatically in the local environment.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=18080
REVERB_SCHEME=http
# Set browser-facing values when different from the internal broadcaster address:
# REVERB_PUBLIC_HOST=chat.example.com
# REVERB_PUBLIC_PORT=443
# REVERB_PUBLIC_SCHEME=https
# Comma-separated hostnames (defaults to FRONTEND_URL's hostname):
# REVERB_ALLOWED_ORIGINS=localhost
# GROQ_API_URL=https://api.groq.com/openai/v1

# Gemini (movie recommendations only). GEMINI_URL is optional.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash
